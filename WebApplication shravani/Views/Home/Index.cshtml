<!-- SEARCH SECTION -->
<div id="search" class="section">
    <h1>Search Products</h1>
    <p style="color: white; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);">Find your favorite organic products</p>

    <div style="position: relative; width: 100%; max-width: 500px;">
        <input type="text" id="searchInput"
               placeholder="Search by name, category (fruits/vegetables), or price..."
               style="padding:15px 50px 15px 20px; width:100%; border-radius:50px; border:none; box-shadow:0 5px 15px rgba(0,0,0,0.2); font-size:16px;">
        <button onclick="searchProducts()"
                style="position:absolute; right:5px; top:5px; background:#2e7d32; color:white; border:none; padding:10px 25px; border-radius:50px; cursor:pointer;">
            <i class="fas fa-search"></i> Search
        </button>

        <div id="suggestions" style="position:absolute; top:100%; left:0; right:0; background:white; border-radius:15px; margin-top:5px; box-shadow:0 10px 25px rgba(0,0,0,0.2); max-height:300px; overflow-y:auto; display:none; z-index:1000;">
        </div>
    </div>

    <div style="display:flex; gap:10px; flex-wrap:wrap; justify-content:center; margin-top:20px;">
        <span class="filter-chip active" data-filter="all" style="background:#2e7d32; color:white; padding:8px 20px; border-radius:25px; cursor:pointer;">All</span>
        <span class="filter-chip" data-filter="Fruits" style="background:white; padding:8px 20px; border-radius:25px; cursor:pointer;">🍎 Fruits</span>
        <span class="filter-chip" data-filter="Vegetables" style="background:white; padding:8px 20px; border-radius:25px; cursor:pointer;">🥬 Vegetables</span>
        <span class="filter-chip" data-filter="under100" style="background:white; padding:8px 20px; border-radius:25px; cursor:pointer;">💰 Under ₹100</span>
    </div>

    <div id="resultsCount" style="margin-top:20px; color:white; font-weight:bold;"></div>
    <div id="searchResults" class="product-grid" style="margin-top:30px; width:100%; max-width:1200px;"></div>
</div>

<script>
    let allProducts = [];
    let currentFilter = "all";

    // Load products from server on page load
    fetch('/Home/GetAllProducts')
        .then(response => response.json())
        .then(data => {
            allProducts = data;
            displayResults(allProducts);
        })
        .catch(error => {
            console.error('Error loading products:', error);
               // Fallback products with correct IDs
    allProducts = [
        { productId: 41, name: "Organic Apples", category: "Fruits", price: 120, imageUrl: "/images/Appleimg.jpg", averageRating: 4.5, totalReviews: 125 },
        { productId: 73, name: "Organic Potato", category: "Vegetables", price: 35, imageUrl: "/images/Potatoimg.jpg", averageRating: 4.7, totalReviews: 98 },
        { productId: 79, name: "Fresh Fenugreek", category: "Vegetables", price: 40, imageUrl: "/images/fenugreek.jpg", averageRating: 4.3, totalReviews: 45 },
        { productId: 76, name: "Organic Spinach", category: "Vegetables", price: 25, imageUrl: "/images/spinach.jpg", averageRating: 4.8, totalReviews: 67 }
    ];
            displayResults(allProducts);
        });

    function searchProducts() {
        const term = document.getElementById("searchInput").value.toLowerCase().trim();
        updateSuggestions(term);

        let filtered = [...allProducts];

        if (term) {
            filtered = filtered.filter(p =>
                (p.name && p.name.toLowerCase().includes(term)) ||
                (p.category && p.category.toLowerCase().includes(term)) ||
                (p.description && p.description.toLowerCase().includes(term)) ||
                p.price.toString().includes(term)
            );
        }

        if (currentFilter !== "all") {
            if (currentFilter === "under100") {
                filtered = filtered.filter(p => p.price < 100);
            } else {
                filtered = filtered.filter(p => p.category === currentFilter);
            }
        }

        displayResults(filtered);
    }

    function filterByCategory(category) {
        currentFilter = category;

        document.querySelectorAll('.filter-chip').forEach(chip => {
            chip.style.background = "white";
            chip.style.color = "#333";
        });
        const activeChip = document.querySelector(`.filter-chip[data-filter="${category}"]`);
        if (activeChip) {
            activeChip.style.background = "#2e7d32";
            activeChip.style.color = "white";
        }

        searchProducts();
    }

    function displayResults(products) {
        const container = document.getElementById("searchResults");
        const countDiv = document.getElementById("resultsCount");

        countDiv.innerHTML = `🍃 Found ${products.length} organic products`;

        if (products.length === 0) {
            container.innerHTML = `
                <div style="background:white; border-radius:15px; padding:40px; text-align:center;">
                    <i class="fas fa-search fa-3x text-muted mb-3"></i>
                    <h4>No products found</h4>
                    <p>Try a different search term</p>
                </div>
            `;
            return;
        }

        container.innerHTML = products.map(p => `
            <div class="product-card">
                <img src="${p.imageUrl || '/images/products/default.jpg'}" alt="${p.name}">
                <a href="/Product/Details/${p.productId}" class="btn" style="display:inline-block; padding:10px; background:#B5E61D; color:darkseagreen; margin-bottom:10px;">
                    VIEW DETAILS
                </a>
                <h3>${p.name}</h3>
                <div class="rating">${getStars(p.averageRating)} (${p.totalReviews || 0} reviews)</div>
                <div class="price">₹${p.price}</div>
                <div class="delivery">🚚 Free Delivery</div>
                <div class="product-actions">
                    <button class="btn" onclick="addToCart(${p.productId})">Add to Cart</button>
                    <button class="btn btn-buy" onclick="buyNow(${p.productId})">Buy Now</button>
                </div>
            </div>
        `).join('');
    }

    function getStars(rating) {
        const full = Math.floor(rating);
        let stars = '';
        for (let i = 0; i < full; i++) stars += '⭐';
        for (let i = full; i < 5; i++) stars += '☆';
        return stars;
    }

    function updateSuggestions(term) {
        const suggestionsDiv = document.getElementById("suggestions");

        if (term.length < 2) {
            suggestionsDiv.style.display = "none";
            return;
        }

        const suggestions = allProducts.filter(p =>
            p.name && p.name.toLowerCase().includes(term)
        ).slice(0, 5);

        if (suggestions.length > 0) {
            suggestionsDiv.innerHTML = suggestions.map(p => `
                <div class="suggestion-item" onclick="selectSuggestion('${p.name}')">
                    <i class="fas fa-apple-alt"></i> ${p.name} - ₹${p.price}
                </div>
            `).join('');
            suggestionsDiv.style.display = "block";
        } else {
            suggestionsDiv.style.display = "none";
        }
    }

    function selectSuggestion(name) {
        document.getElementById("searchInput").value = name;
        document.getElementById("suggestions").style.display = "none";
        searchProducts();
    }

    // ============= ADD TO CART & BUY NOW FUNCTIONS =============

    function addToCart(productId) {
        fetch(`/Order/AddToCart?id=${productId}&quantity=1`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showToast(data.message, "success");
                updateCartCount();
            } else {
                showToast(data.message, "warning");
                if (data.redirect) {
                    setTimeout(() => { window.location.href = data.redirect; }, 1500);
                }
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showToast("Something went wrong", "error");
        });
    }

    function buyNow(productId) {
        window.location.href = `/Order/BuyNow/${productId}`;
    }

    function showToast(message, type) {
        const toast = document.createElement('div');
        toast.className = `toast-message toast-${type}`;
        toast.innerHTML = message;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }

    function updateCartCount() {
        fetch('/Cart/GetCartCount')
            .then(response => response.json())
            .then(data => {
                const cartIcon = document.querySelector('.navbar-right a[href*="Cart"]');
                if (cartIcon && data.count > 0) {
                    cartIcon.innerHTML = `🛒 Cart (${data.count})`;
                } else if (cartIcon) {
                    cartIcon.innerHTML = `🛒 Cart`;
                }
            })
            .catch(error => console.error('Error updating cart count:', error));
    }

    // Event Listeners
    document.getElementById("searchInput").addEventListener("keyup", function(e) {
        if (e.key === "Enter") searchProducts();
        else updateSuggestions(this.value);
    });

    document.querySelectorAll('.filter-chip').forEach(chip => {
        chip.addEventListener('click', () => filterByCategory(chip.dataset.filter));
    });

    document.addEventListener('click', (e) => {
        if (!e.target.closest('#searchInput') && !e.target.closest('#suggestions')) {
            document.getElementById("suggestions").style.display = "none";
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        updateCartCount();
    });
</script>