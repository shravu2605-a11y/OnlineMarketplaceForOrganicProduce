@model List<WebApplication_shravani.Models.Product>

@{
    ViewData["Title"] = "My Products";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        background: #f5f7fa;
    }

    .product-card {
        border-radius: 15px;
        overflow: hidden;
        transition: 0.3s;
        background: white;
    }

        .product-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        }

    .product-img {
        height: 200px;
        object-fit: cover;
        width: 100%;
    }

    .price {
        font-weight: bold;
        color: green;
        font-size: 18px;
    }

    .btn-custom {
        border-radius: 20px;
        padding: 5px 15px;
    }
</style>

<div class="container mt-4">

    <h2 class="text-center mb-4">🌿 My Products</h2>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="product-card shadow">

                    <!-- IMAGE -->
                    <img src="@item.ImageUrl" class="product-img" alt="Product Image" />

                    <div class="p-3 text-center">

                        <!-- NAME -->
                        <h5>@item.Name</h5>

                        <!-- PRICE -->
                        <p class="price">₹ @item.Price</p>

                        <!-- DESCRIPTION -->
                        <p class="text-muted">@item.Description</p>

                        <!-- BUTTONS -->
                        <div class="d-flex justify-content-center gap-2">

                            <a asp-action="Edit" asp-route-id="@item.ProductId"
                               class="btn btn-warning btn-custom">
                                ✏️ Edit
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.ProductId"
                               class="btn btn-danger btn-custom">
                                🗑️ Delete
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>