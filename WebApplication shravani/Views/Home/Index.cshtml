    <div style="display:flex; gap:20px; flex-wrap:wrap; justify-content:center; margin-top:30px;">
        <div class="welcome-box">
            <h3>🌱 100% Organic</h3>
            <p>Chemical-free vegetables grown by trusted farmers.</p>
        </div>
        <div class="welcome-box">
            <h3>🚜 Direct From Farmers</h3>
            <p>We connect farmers directly with customers.</p>
        </div>
        <div class="welcome-box">
            <h3>🚚 Fast Delivery</h3>
            <p>Fresh produce delivered quickly to your location.</p>
        </div>
    </div>
</div>

