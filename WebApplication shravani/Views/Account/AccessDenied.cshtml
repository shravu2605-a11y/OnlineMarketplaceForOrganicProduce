@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center mt-5">
    <div class="alert alert-warning shadow-lg p-5" style="border-radius: 20px;">
        <i class="fas fa-exclamation-triangle fa-4x mb-3" style="color: #ff9800;"></i>
        <h2 class="mt-3">Login Required</h2>
        <p class="lead">Please login to access this page.</p>
        <hr>
        <p>You need to be logged in to add items to cart and place orders.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg mt-3">
            <i class="fas fa-sign-in-alt"></i> Login
        </a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-lg mt-3 ms-2">
            <i class="fas fa-home"></i> Continue Shopping
        </a>
    </div>
</div>