@model WebApplication_shravani.Models.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "Organic Marketplace For Organic Produce";
}

@if (TempData["Success"] != null)
{
    <div style="background:lightgreen;padding:10px;margin:10px;">
        @TempData["Success"]
    </div>
}

<style>
    /* GLOBAL */
    * {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI',Tahoma,sans-serif;
        scroll-behavior: smooth;
    }

    /* NAVBAR */
    .navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: rgba(0,0,0,0.9);
        padding: 14px 30px;
        position: fixed;
        width: 100%;
        top: 0;
        z-index: 1000;
    }

    .navbar-left,
    .navbar-right {
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .navbar-left a {
            color: white;
            text-decoration: none;
            font-size: 22px;
            font-weight: bold;
        }

        .navbar-right a {
            background: #8BC34A;
            color: black;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: bold;
            text-decoration: none;
        }

    /* SECTIONS */
    .section {
        min-height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        background-size: cover;
        background-position: center;
        padding-top: 90px;
    }

    #dashboard {
        background-image: url('/images/farm.jpg');
    }

    #home {
        background-image: url('/images/backgroundfarm.jpg');
    }

    #search {
        background-image: url('/images/searchsection.jpg');
    }

    /* WELCOME BOX */
    .welcome-box {
        background: rgba(255,255,255,0.92);
        padding: 40px;
        border-radius: 15px;
        max-width: 650px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        transition: 0.3s;
    }

        .welcome-box:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.35);
        }

        .welcome-box h1 {
            color: #2E7D32;
        }

    .shop-btn {
        display: inline-block;
        margin-top: 15px;
        padding: 12px 25px;
        background: #2E7D32;
        color: white;
        border-radius: 25px;
        text-decoration: none;
        font-weight: bold;
    }

        .shop-btn:hover {
            background: #1B5E20;
        }

    /* PRODUCT GRID */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px;
        max-width: 1200px;
        width: 100%;
        margin-top: 30px;
    }

    .product-card {
        background: white;
        border-radius: 12px;
        padding: 18px;
        box-shadow: 0 6px 15px rgba(0,0,0,0.15);
        transition: 0.3s;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

        .product-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 10px;
        }

    .price {
        font-size: 1.3rem;
        font-weight: bold;
        color: #2e7d32;
        margin: 10px 0;
    }

    .old-price {
        text-decoration: line-through;
        color: #999;
        font-size: 0.9rem;
        margin-left: 8px;
    }

    .discount {
        color: #ff5722;
        font-size: 0.85rem;
        margin-left: 8px;
    }

    .delivery {
        color: #4caf50;
        font-size: 0.85rem;
        margin: 8px 0;
    }

    .rating {
        color: #ffc107;
        margin: 10px 0;
    }

    .btn {
        background: linear-gradient(135deg, #2e7d32, #66bb6a);
        color: white;
        padding: 8px 12px;
        border: none;
        border-radius: 20px;
        cursor: pointer;
        font-size: 12px;
        margin: 5px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
    }

        .btn:hover {
            transform: scale(1.05);
            background: linear-gradient(135deg, #1b5e20, #4caf50);
            color: white;
            text-decoration: none;
        }

    .btn-buy {
        background: linear-gradient(135deg, #ff5722, #ff9800);
    }

        .btn-buy:hover {
            background: linear-gradient(135deg, #e64a19, #f57c00);
        }

    .product-actions {
        display: flex;
        gap: 8px;
        justify-content: center;
        margin-top: 10px;
    }

    .filter-chip {
        transition: all 0.3s ease;
    }

        .filter-chip:hover {
            transform: translateY(-2px);
            background: #2e7d32 !important;
            color: white !important;
        }

    .suggestion-item {
        padding: 12px 20px;
        cursor: pointer;
        transition: 0.2s;
        border-bottom: 1px solid #eee;
    }

        .suggestion-item:hover {
            background: #e8f5e9;
        }

    /* Toast Message */
    .toast-message {
        position: fixed;
        bottom: 20px;
        right: 20px;
        padding: 12px 24px;
        border-radius: 50px;
        z-index: 9999;
        animation: slideIn 0.3s ease;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .toast-success {
        background: #2e7d32;
        color: white;
    }

    .toast-warning {
        background: #ff9800;
        color: white;
    }

    .toast-error {
        background: #dc3545;
        color: white;
    }

    @@keyframes slideIn {
        from

    {
        transform: translateX(100%);
        opacity: 0;
    }

    to {
        transform: translateX(0);
        opacity: 1;
    }

    }
</style>

<!-- NAVBAR -->
<div class="navbar">
    <div class="navbar-left">
        <a href="#dashboard">🌿 Organic Marketplace</a>
    </div>
    <div class="navbar-right">
        <a href="#home">Home</a>
        <a href="#search">Search</a>
        <a asp-controller="Home" asp-action="Fruits">Fruits</a>
        <a asp-controller="Home" asp-action="Vegetables">Vegetables</a>
        <a asp-controller="Cart" asp-action="Index">🛒 Cart</a>
        @if (Context.Session.GetString("UserRole") == null)
        {
            <a asp-controller="Account" asp-action="Login">Login/Register</a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Logout">Logout</a>
        }
    </div>
</div>

<!-- WELCOME PAGE -->
