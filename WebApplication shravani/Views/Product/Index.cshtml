@model IEnumerable<WebApplication_shravani.Models.Product>

@{
    ViewData["Title"] = "Manage Products";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📦 Manage Products</h2>

        <a asp-controller="Product" asp-action="Create" class="btn btn-success">
            ➕ Add New Product
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Product Name</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Category</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" width="70" height="70" style="object-fit:cover;border-radius:8px;" />
                                }
                                else
                                {
                                    <span class="text-muted">No Image</span>
                                }
                            </td>

                            <td>
                                <strong>@item.Name</strong>
                            </td>

                            <td>
                                @item.Description
                            </td>

                            <td>
                                <span class="badge bg-success">₹@item.Price</span>
                            </td>

                            <td>
                                <span class="badge bg-info text-dark">@item.Category</span>
                            </td>

                            <td>

                                <a asp-action="Edit" asp-route-id="@item.ProductId"
                                   class="btn btn-warning btn-sm">
                                    ✏ Edit
                                </a>

                                <a asp-action="Delete" asp-route-id="@item.ProductId"
                                   class="btn btn-danger btn-sm">
                                    🗑 Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>